DATABASE_URL=postgres://user:password@localhost:5432/parkintel?sslmode=disable
ONNX_MODEL_DIR=./models/onnx
PORT=8080
GIN_MODE=release
# Production/container path to the ONNX Runtime shared library baked into the backend image.
ONNX_RUNTIME_LIB_PATH=/usr/lib/libonnxruntime.so.1.27.0

# Local dev alternative, if running from backend/ and using the Python venv package:
# ONNX_RUNTIME_LIB_PATH=../ml-python/.venv/lib/python3.12/site-packages/onnxruntime/capi/libonnxruntime.so.1.27.0
